---
import Base from "../layouts/Base.astro";
---

<Base title="Scheda auto — Vlookar" pubblica>
  <div class="wrap">
    <nav class="briciole" aria-label="Percorso">
      <a href="/">Auto</a><span aria-hidden="true">/</span><span id="bc-marca">…</span><span aria-hidden="true">/</span><span id="bc-modello">…</span>
    </nav>

    <header class="testata">
      <div class="testata-riga">
        <div class="testata-nome">
          <h1 id="titolo">Scheda auto</h1>
          <p id="sottotitolo" class="allestimento"></p>
          <p id="creata" class="creata" hidden></p>
        </div>
        <section id="mantenimento" class="mantenimento" aria-labelledby="totale-nome" hidden>
          <h2 id="totale-nome" class="etichetta">Mantenimento annuo</h2>
          <div id="totale" class="totale" aria-live="polite">
            <p class="totale-riga"><span class="totale-da">da</span><span id="tot-min" class="totale-num cifra">—</span><span class="totale-euro">€</span></p>
            <p class="totale-riga"><span class="totale-da">a</span><span id="tot-max" class="totale-num cifra">—</span><span class="totale-euro">€</span></p>
          </div>
          <p id="totale-stato" class="totale-stato" hidden></p>
          <p class="totale-composizione"><span id="tot-composizione">Assicurazione + bollo + tagliandi</span> <span class="origine origine-calcolato">Calcolato</span></p>
        </section>
      </div>
      <dl id="specifiche" class="specifiche" hidden></dl>
    </header>

    <!-- i dati con cui sono calcolati i costi: si cambiano dal form, non qui -->
    <div id="profilo" class="profilo" hidden>
      <dl id="profilo-dati" class="profilo-dati"></dl>
      <button id="modifica" class="btn-link" type="button">Modifica i tuoi dati</button>
    </div>

    <div id="servono-dati" class="avviso avviso-azione" hidden>
      <p>Per calcolare il bollo serve la tua regione; per stimare l'assicurazione anche via, data di nascita e classe di merito.</p>
      <button id="inserisci-dati" class="btn" type="button">Inserisci i dati</button>
    </div>

    <div id="attesa" class="attesa" role="status" aria-live="polite" hidden>
      <span class="attesa-barra" aria-hidden="true"></span>
      <p><strong>Stiamo stimando prezzo, tagliando e problemi tipici.</strong> La prima volta che qualcuno cerca quest'auto può volerci fino a un minuto; intanto qui sotto trovi i dati già pronti.</p>
    </div>

    <div id="errore" class="avviso avviso-azione" role="alert" hidden></div>
    <div id="senza-stima" class="avviso avviso-azione" hidden></div>

    <!-- ============================================================ calcolatore -->
    <div id="calcolatore" class="calcolatore" hidden>
      <section class="conto" aria-labelledby="conto-titolo">
        <h2 id="conto-titolo" class="visually-hidden">Voci di costo</h2>

        <article class="voce" aria-labelledby="bollo-nome">
          <div class="voce-testa">
            <h3 id="bollo-nome" class="etichetta">Bollo<span id="bollo-asterisco" class="asterisco" hidden>*</span></h3>
            <span class="origine origine-calcolato">Calcolato</span>
          </div>
          <p class="voce-importo cifra" id="bollo-importo">—</p>
          <p class="voce-nota" id="bollo-nota"></p>
        </article>

        <article class="voce" aria-labelledby="ass-nome">
          <div class="voce-testa">
            <h3 id="ass-nome" class="etichetta">Assicurazione RC</h3>
            <span class="origine origine-stima_llm">Stima AI</span>
          </div>
          <p class="voce-importo cifra" id="ass-importo">—</p>
          <p id="ass-per-chi" class="per-chi"></p>
          <p class="voce-nota" id="ass-nota"></p>
        </article>

        <article class="voce" aria-labelledby="tag-nome">
          <div class="voce-testa">
            <h3 id="tag-nome" class="etichetta">Tagliando</h3>
            <span class="origine origine-stima_llm">Stima AI</span>
          </div>
          <dl class="officine">
            <div><dt>Officina autorizzata</dt><dd id="tag-aut" class="cifra">—</dd></div>
            <div><dt>Officina di fiducia</dt><dd id="tag-mec" class="cifra">—</dd></div>
          </dl>
          <p class="voce-nota" id="tag-nota"></p>
        </article>

      </section>
    </div>

    <!-- nome e versione in piccolo, fissi in alto quando la testata esce dallo schermo -->
    <div id="compatta" class="compatta" aria-hidden="true">
      <div class="wrap compatta-interno">
        <span id="compatta-nome" class="compatta-nome"></span>
        <span id="compatta-versione" class="compatta-versione"></span>
      </div>
    </div>

    <!-- riepilogo fisso in basso sul telefono, quando la testata esce dallo schermo -->
    <div id="mini" class="mini" aria-hidden="true" hidden>
      <span class="etichetta">Mantenimento annuo</span>
      <span id="mini-valore" class="mini-valore cifra">—</span>
    </div>

    <div id="resto" class="resto" hidden></div>
  </div>
</Base>

<style>
  .briciole {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 24px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--grafite);
  }
  .briciole a {
    color: var(--grafite);
  }

  /* ---- testata: il nome dell'auto, poi una riga di specifiche separate da filetti */
  .testata {
    padding: 20px 0 28px;
    border-bottom: 1px solid var(--inchiostro);
  }
  .testata:has(+ .profilo:not([hidden])) {
    border-bottom-color: var(--filo);
  }
  .testata-riga {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 760px) {
    .testata-riga {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 48px;
    }
  }
  .testata h1 {
    font-size: clamp(2.5rem, 7.5vw, 5.5rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .allestimento {
    margin: 10px 0 0;
    font-family: var(--mono);
    font-size: 1rem;
  }
  .creata {
    margin: 6px 0 0;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--grafite);
  }
  .specifiche {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    margin: 28px 0 0;
    border-top: 1px solid var(--filo);
  }
  .specifiche :global(div) {
    padding: 12px 16px 0 0;
  }
  .specifiche :global(dt) {
    margin-bottom: 4px;
  }
  .specifiche :global(dd) {
    margin: 0;
    font-weight: 500;
  }
  .specifiche :global(.spec-nota) {
    display: block;
    margin-top: 2px;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--grafite);
  }
  .specifiche :global(.origine) {
    margin-top: 6px;
  }

  .avviso {
    margin-top: 24px;
  }

  .profilo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--inchiostro);
  }
  .profilo-dati {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 0;
  }
  .profilo-dati :global(dt) {
    margin-bottom: 2px;
  }
  .profilo-dati :global(dd) {
    margin: 0;
    font-size: 0.9375rem;
  }

  .attesa {
    margin-top: 32px;
    max-width: 44em;
  }
  .attesa p {
    margin: 12px 0 0;
  }
  .attesa-barra {
    display: block;
    height: 2px;
    background: var(--filo);
    position: relative;
    overflow: hidden;
  }
  .attesa-barra::after {
    content: "";
    position: absolute;
    inset: 0;
    width: 30%;
    background: var(--inchiostro);
  }
  @media (prefers-reduced-motion: no-preference) {
    .attesa-barra::after {
      animation: scorri 1.4s ease-in-out infinite;
    }
    @keyframes scorri {
      from { transform: translateX(-100%); }
      to { transform: translateX(340%); }
    }
  }

  .voce {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--filo);
  }
  .voce > :not(.voce-testa, .voce-importo) {
    grid-column: 1 / -1;
  }
  .voce-testa {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
  }
  .voce-testa h3 {
    color: var(--inchiostro);
  }
  .voce-importo {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-align: right;
    white-space: nowrap;
  }
  .voce-importo :global(.importo-pieno) {
    display: block;
    margin-top: 2px;
    white-space: normal;
  }
  .voce-importo :global(small) {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0;
    color: var(--grafite);
  }
  .voce-nota {
    margin: 4px 0 0;
    font-size: 0.875rem;
    color: var(--grafite);
    max-width: 62ch;
  }
  .voce-nota :global(a) {
    color: var(--grafite);
  }
  .voce-nota :global(.eccezione) {
    display: block;
    margin-top: 6px;
  }
  .asterisco {
    margin-left: 2px;
  }

  .per-chi {
    margin: 10px 0 0;
    font-size: 0.9375rem;
  }

  .officine {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 14px 0 0;
  }
  .officine div {
    padding: 10px 16px 0 0;
  }
  .officine dt {
    font-size: 0.875rem;
    color: var(--grafite);
  }
  .officine dd {
    margin: 2px 0 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* ---- il totale: due cifre una sopra l'altra, allineate a destra come in un registro */
  .mantenimento {
    min-width: 240px;
  }
  .totale {
    margin: 8px 0 0;
  }
  .totale-riga {
    display: grid;
    grid-template-columns: 1.6em 1fr auto;
    align-items: baseline;
    margin: 0;
    color: var(--segnale);
  }
  .totale-riga + .totale-riga {
    border-top: 1px solid var(--filo);
  }
  .totale-da,
  .totale-euro {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--grafite);
  }
  .totale-euro {
    padding-left: 6px;
  }
  .totale-num {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    text-align: right;
  }
  .totale.in-attesa .totale-num {
    color: var(--filo-forte);
  }
  .totale-composizione {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    margin: 8px 0 0;
    padding-top: 8px;
    border-top: 1px solid var(--inchiostro);
    font-size: 0.8125rem;
    color: var(--grafite);
  }
  .totale-stato {
    margin: 6px 0 0;
    font-size: 0.8125rem;
    color: var(--grafite);
  }
  /* ---- testata compatta: sotto la barra del sito (56px + filetto) */
  .compatta {
    position: fixed;
    top: 57px;
    left: 0;
    right: 0;
    z-index: 9;
    background: var(--carta);
    border-bottom: 1px solid var(--inchiostro);
    transform: translateY(-100%);
    visibility: hidden;
  }
  .compatta.visibile {
    transform: none;
    visibility: visible;
  }
  @media (prefers-reduced-motion: no-preference) {
    .compatta {
      transition: transform var(--durata) ease-out, visibility var(--durata);
    }
  }
  .compatta-interno {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .compatta-nome {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .compatta-versione {
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  /* ---- riepilogo fisso sul telefono */
  .mini {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: var(--carta);
    border-top: 1px solid var(--inchiostro);
  }
  .mini-valore {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--segnale);
  }
  @media (min-width: 1000px) {
    .mini {
      display: none;
    }
  }

  /* ---- il resto della scheda: titolo a sinistra, contenuto a destra */
  .resto {
    margin-top: 56px;
  }
  .resto :global(.blocco) {
    display: grid;
    gap: 12px;
    padding: 24px 0 32px;
    border-top: 1px solid var(--inchiostro);
  }
  .resto :global(.blocco-titolo) {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .resto :global(.blocco-titolo h2) {
    font-size: 1.375rem;
  }
  .resto :global(.blocco-corpo) {
    min-width: 0;
    max-width: 72ch;
  }
  .resto :global(.blocco-corpo > p) {
    margin: 0;
  }
  @media (min-width: 1000px) {
    .resto :global(.blocco) {
      grid-template-columns: 3fr 9fr;
      gap: 40px;
    }
  }
  .resto :global(.elenco) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .resto :global(.elenco > li) {
    padding: 14px 0;
    border-bottom: 1px solid var(--filo);
  }
  .resto :global(.elenco > li:first-child) {
    padding-top: 0;
  }
  .resto :global(.elenco > li:last-child) {
    border-bottom: 0;
  }
  .resto :global(.elenco p) {
    margin: 4px 0 0;
    color: var(--grafite);
  }
  .resto :global(.problema-testa) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  .resto :global(.gravita) {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 1px 6px;
    border: 1px solid currentColor;
  }
  .resto :global(.gravita-alta) {
    color: var(--neg);
  }
  .resto :global(.gravita-media) {
    color: var(--warn);
  }
  .resto :global(.gravita-bassa) {
    color: var(--grafite);
  }
  .resto :global(.costi-riparazione) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .resto :global(.costi-riparazione span) {
    color: var(--grafite);
  }
  .resto :global(.costi-riparazione strong) {
    color: var(--inchiostro);
    font-weight: 500;
  }
  .resto :global(.nota-fonte) {
    margin: 14px 0 0 !important;
    font-size: 0.8125rem;
    color: var(--grafite);
  }

  /* revisioni UK: due barre per età, questo motore e la media */
  .resto :global(.mot) {
    display: grid;
    gap: 14px;
  }
  .resto :global(.mot-riga) {
    display: grid;
    grid-template-columns: 72px 1fr 56px;
    gap: 4px 12px;
    align-items: center;
    font-size: 0.875rem;
  }
  .resto :global(.mot-eta) {
    grid-row: span 2;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .resto :global(.mot-traccia) {
    height: 10px;
    background: var(--carta-2);
  }
  .resto :global(.mot-barra) {
    height: 100%;
    background: var(--inchiostro);
  }
  .resto :global(.mot-barra.media) {
    background: var(--filo-forte);
  }
  .resto :global(.mot-num) {
    font-family: var(--mono);
    text-align: right;
  }
  .resto :global(.mot-legenda) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 0 0 16px !important;
    font-size: 0.8125rem;
    color: var(--grafite);
  }
  .resto :global(.mot-legenda span::before) {
    content: "";
    display: inline-block;
    width: 14px;
    height: 10px;
    margin-right: 8px;
    background: var(--inchiostro);
  }
  .resto :global(.mot-legenda .l-media::before) {
    background: var(--filo-forte);
  }
  .resto :global(.nota-finale) {
    padding-top: 20px;
    border-top: 1px solid var(--inchiostro);
    margin: 0;
    font-size: 0.8125rem;
    color: var(--grafite);
  }

  @media (max-width: 999px) {
    :global(main) {
      padding-bottom: 120px;
    }
  }
</style>

<script>
  import "../lib/paginaScheda";
</script>
