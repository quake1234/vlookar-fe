---
// La scheda con la grafica "cruscotto": stessi dati e stessa logica di /car (lib/paginaScheda.ts),
// cambia solo l'aspetto. Tema scuro, un pannello strumenti unico, cifre condensate, ambra solo
// per il totale e l'azione principale.
import Base from "../layouts/Base.astro";

// Tacche del quadrante: disegno fisso, tre quarti di giro come un contagiri. Le cifre delle tacche
// lunghe e la posizione della lancetta arrivano dal backend (mantenimento.quadrante).
const TACCHE = 40;
// zona rossa dei fuorigiri: l'ultimo tratto fra tacche lunghe e metà del penultimo
const FUORIGIRI = TACCHE - 7.5;
const tacche = Array.from({ length: TACCHE + 1 }, (_, i) => {
  const a = ((135 + (270 * i) / TACCHE) * Math.PI) / 180;
  const lunga = i % 5 === 0;
  const p = (r: number) => [(100 + r * Math.cos(a)).toFixed(2), (100 + r * Math.sin(a)).toFixed(2)];
  const [x1, y1] = p(lunga ? 85 : 89);
  const [x2, y2] = p(95);
  return { x1, y1, x2, y2, lunga, rossa: i >= FUORIGIRI };
});
// l'arco ambra, appena dentro le tacche, che diventa rosso nei fuorigiri
const punto = (g: number, r: number) => {
  const a = (g * Math.PI) / 180;
  return `${(100 + r * Math.cos(a)).toFixed(2)} ${(100 + r * Math.sin(a)).toFixed(2)}`;
};
// posizione delle cifre delle tacche lunghe, dentro l'arco: le riempie lo script con i valori del backend
const cifreScala = tacche.filter((t) => t.lunga).map((_, k) => {
  const [x, y] = punto(135 + (270 * k) / 8, 66).split(" ");
  return { x, y };
});
const inizioRosso = 135 + (270 * FUORIGIRI) / TACCHE;
const arco = `M ${punto(135, 80)} A 80 80 0 1 1 ${punto(inizioRosso, 80)}`;
const arcoRosso = `M ${punto(inizioRosso, 80)} A 80 80 0 0 1 ${punto(45, 80)}`;
---

<Base title="Scheda auto — Vroomy">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap" />

  <div class="wrap cruscotto">
    <nav class="briciole" aria-label="Percorso">
      <a href="/">Auto</a><span aria-hidden="true">/</span><span id="bc-marca">…</span><span aria-hidden="true">/</span><span id="bc-modello">…</span>
    </nav>

    <header class="testata">
      <div class="testata-nome">
        <h1 id="titolo">Scheda auto</h1>
        <p id="sottotitolo" class="allestimento"></p>
        <p id="creata" class="creata" hidden></p>
      </div>
    </header>

    <div id="servono-dati" class="avviso avviso-azione" hidden>
      <p>Per calcolare bollo e assicurazione servono la tua regione e, se vuoi una stima su misura, età, classe di merito e via.</p>
      <button id="inserisci-dati" class="btn" type="button">Inserisci i dati</button>
    </div>

    <div id="attesa" class="attesa" role="status" aria-live="polite" hidden>
      <span class="attesa-barra" aria-hidden="true"></span>
      <p><strong>Stiamo stimando prezzo, assicurazione, tagliando e problemi tipici.</strong> La prima volta che qualcuno cerca quest'auto può volerci fino a un minuto; intanto qui sotto trovi i dati già pronti.</p>
    </div>

    <div id="errore" class="avviso avviso-azione" role="alert" hidden></div>
    <div id="senza-stima" class="avviso avviso-azione" hidden></div>

    <!-- il pannello strumenti: quadrante del totale a sinistra, letture delle voci a destra -->
    <div class="plancia">
      <section id="mantenimento" class="mantenimento" aria-labelledby="totale-nome" hidden>
        <div class="quadrante">
          <svg class="scala" viewBox="0 0 200 200" aria-hidden="true">
            {tacche.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class:list={["tacca", { lunga: t.lunga, rossa: t.rossa }]} />)}
            <path d={arco} class="arco" />
            <path d={arcoRosso} class="arco arco-rosso" />
            {cifreScala.map((c) => <text x={c.x} y={c.y} class="cifra-scala"></text>)}
            <!-- lancetta: disegnata verso destra (0°), la ruota l'animazione; corta, per non passare sulle cifre -->
            <line x1="158" y1="100" x2="193" y2="100" class="lancetta" />
          </svg>
          <div id="totale" class="totale" aria-live="polite">
            <h2 id="totale-nome" class="totale-nome">Mantenimento annuo</h2>
            <p class="totale-riga"><span class="totale-da">da</span><span id="tot-min" class="totale-num cifra">—</span><span class="totale-euro">€</span></p>
            <p class="totale-riga"><span class="totale-da">a</span><span id="tot-max" class="totale-num cifra">—</span><span class="totale-euro">€</span></p>
            <p class="totale-calcolo">Calcolo in corso…</p>
          </div>
          <span class="totale-unita" aria-hidden="true">€ / anno</span>
        </div>
        <p id="totale-stato" class="totale-stato" hidden></p>
        <p class="totale-composizione">Assicurazione, bollo e tagliandi sommati <span class="origine origine-calcolato">Calcolato</span></p>
      </section>

      <div id="calcolatore" class="calcolatore" hidden>
        <section class="conto" aria-labelledby="conto-titolo">
          <h2 id="conto-titolo" class="visually-hidden">Voci di costo</h2>

          <article class="voce" aria-labelledby="bollo-nome">
            <div class="voce-testa">
              <h3 id="bollo-nome">Bollo<span id="bollo-asterisco" class="asterisco" hidden>*</span></h3>
              <span class="origine origine-calcolato">Calcolato</span>
            </div>
            <p class="voce-importo cifra" id="bollo-importo">—</p>
            <p class="voce-nota" id="bollo-nota"></p>
          </article>

          <article class="voce" aria-labelledby="ass-nome">
            <div class="voce-testa">
              <h3 id="ass-nome">Assicurazione RC</h3>
              <span class="origine origine-stima_llm">Stima AI</span>
            </div>
            <p class="voce-importo cifra" id="ass-importo">—</p>
            <p id="ass-per-chi" class="per-chi"></p>
            <p class="voce-nota" id="ass-nota"></p>
          </article>

          <article class="voce" aria-labelledby="tag-nome">
            <div class="voce-testa">
              <h3 id="tag-nome">Tagliando</h3>
              <span class="origine origine-stima_llm">Stima AI</span>
            </div>
            <dl class="officine">
              <div><dt>Officina autorizzata</dt><dd id="tag-aut" class="cifra">—</dd></div>
              <div><dt>Officina di fiducia</dt><dd id="tag-mec" class="cifra">—</dd></div>
            </dl>
            <p class="voce-nota" id="tag-nota"></p>
          </article>
        </section>
      </div>
    </div>

    <!-- i dati dell'auto, in fila come il computer di bordo -->
    <dl id="specifiche" class="specifiche" hidden></dl>

    <!-- i dati con cui sono calcolati i costi: si cambiano dal form, non qui -->
    <div id="profilo" class="profilo" hidden>
      <p class="profilo-titolo">Calcolato per</p>
      <dl id="profilo-dati" class="profilo-dati"></dl>
      <button id="modifica" class="btn btn-secondario" type="button">Modifica i tuoi dati</button>
    </div>

    <!-- nome e versione in piccolo, fissi in alto quando la testata esce dallo schermo -->
    <div id="compatta" class="compatta" aria-hidden="true">
      <div class="wrap compatta-interno">
        <span id="compatta-nome" class="compatta-nome"></span>
        <span id="compatta-versione" class="compatta-versione"></span>
      </div>
    </div>

    <!-- riepilogo fisso in basso sul telefono, quando la testata esce dallo schermo -->
    <div id="mini" class="mini" aria-hidden="true" hidden>
      <span class="mini-nome">Mantenimento annuo</span>
      <span id="mini-valore" class="mini-valore cifra">—</span>
    </div>

    <div id="resto" class="resto" hidden></div>
  </div>
</Base>

<!-- Il tema scuro vale per tutta la pagina, barra del sito e form dei dati compresi. -->
<style is:global>
  /* :not(#_) alza la specificità sopra quella dei temi di tema.css, chiaro o scuro che sia */
  :root:not(#_) {
    --font: "Barlow", "Helvetica Neue", Arial, sans-serif;
    --condensato: "Barlow Condensed", "Arial Narrow", sans-serif;
    --carta: #111315;
    --carta-2: #1a1d20;
    --pannello: #16191c;
    --inchiostro: #e6e4df;
    --grafite: #979a9e;         /* testo secondario: 6,5:1 sul fondo */
    --filo: #26292d;
    --filo-forte: #3b3f44;
    --segnale: #f5a300;         /* ambra delle lancette: solo totale e azione principale */
    --su-segnale: #111315;
    --ufficiale: #58c38f;
    --fuorigiri: #e5392f;       /* zona rossa del quadrante: solo decorazione */
    --neg: #ef6f5e;
    --neg-soft: #3a1c19;
    --warn: #f5a300;
    --radius: 6px;
    --radius-sm: 4px;
    color-scheme: dark;
  }
  .origine-ufficiale::before {
    color: var(--ufficiale);
  }
  .origine-stima_llm::before {
    color: var(--segnale);
  }
  .btn {
    font-weight: 600;
  }
  .avviso {
    border-left-color: var(--segnale);
  }

  /* Cursore a forma di auto: fari spenti sulla pagina, anabbaglianti sopra ciò che si clicca,
     abbaglianti mentre si tiene premuto il tasto, ovunque. Il punto attivo (14 14) è sul muso. Senza immagine: il cursore solito. */
  html {
    cursor: url("/cursore/auto.svg") 14 14, auto;
  }
  :is(a[href], button:not(:disabled), select:not(:disabled), label[for], summary, [role="button"], [role="option"]):hover {
    cursor: url("/cursore/auto-anabbaglianti.svg") 14 14, pointer;
  }
  /* abbaglianti a ogni clic, ovunque si prema: la classe la mette lo script qui sotto */
  html.abbaglianti,
  html.abbaglianti * {
    cursor: url("/cursore/auto-abbaglianti.svg") 14 14, auto !important;
  }
  /* nei campi di testo resta la barra per scrivere */
  input:not([type="button"], [type="submit"], [type="checkbox"], [type="radio"]), textarea {
    cursor: text;
  }
</style>

<style>
  .briciole {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 24px;
    font-size: 0.875rem;
    color: var(--grafite);
  }
  .briciole a {
    color: var(--grafite);
  }

  /* ---- testata: il nome come su un badge del portellone, la versione sotto */
  .testata {
    padding: 10px 0 28px;
  }
  .testata h1 {
    font-family: var(--condensato);
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  .allestimento {
    margin: 10px 0 0;
    font-size: 1.0625rem;
    color: var(--grafite);
  }
  .creata {
    margin: 4px 0 0;
    font-size: 0.875rem;
    color: var(--grafite);
  }
  .creata :global(a) {
    color: var(--inchiostro);
  }

  .avviso {
    margin-bottom: 24px;
  }
  .attesa {
    margin-bottom: 24px;
    max-width: 44em;
  }
  .attesa p {
    margin: 12px 0 0;
  }
  .attesa-barra {
    display: block;
    height: 2px;
    background: var(--filo);
    position: relative;
    overflow: hidden;
  }
  .attesa-barra::after {
    content: "";
    position: absolute;
    inset: 0;
    width: 30%;
    background: var(--segnale);
  }
  @media (prefers-reduced-motion: no-preference) {
    .attesa-barra::after {
      animation: scorri 1.4s ease-in-out infinite;
    }
    @keyframes scorri {
      from { transform: translateX(-100%); }
      to { transform: translateX(340%); }
    }
  }

  /* ---- pannello strumenti: una sola cornice, divisa da un filetto verticale */
  .plancia {
    display: grid;
  }
  .plancia:has(> :not([hidden])) {
    background: var(--pannello);
    border: 1px solid var(--filo);
    border-radius: 14px 14px 6px 6px;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04), 0 20px 40px -24px rgb(0 0 0 / 0.8);
  }
  @media (min-width: 1000px) {
    .plancia {
      grid-template-columns: 400px minmax(0, 1fr);
    }
    .plancia > .calcolatore {
      border-left: 1px solid var(--filo);
    }
  }
  @media (max-width: 999px) {
    .plancia > .calcolatore {
      border-top: 1px solid var(--filo);
    }
  }

  /* ---- il quadrante: scala fissa, due cifre della stessa misura, unità nell'apertura in basso */
  .mantenimento {
    display: grid;
    justify-items: center;
    gap: 14px;
    padding: 28px 24px 24px;
  }
  .quadrante {
    position: relative;
    width: min(320px, 100%);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .scala {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tacca {
    stroke: var(--filo-forte);
    stroke-width: 1.2;
  }
  .tacca.lunga {
    stroke: var(--grafite);
    stroke-width: 2;
  }
  .tacca.rossa {
    stroke: var(--fuorigiri);
  }
  .arco {
    fill: none;
    stroke: var(--segnale);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .arco-rosso {
    stroke: var(--fuorigiri);
  }
  /* La lancetta oscilla fra il minimo e il massimo del mantenimento, come un motore al minimo.
     --min e --max sono le posizioni in percentuale del fondo scala, calcolate dal backend
     (mantenimento.quadrante); qui si trasformano in un angolo del disegno (135° + 270° × pct).
     Senza dati: fra la terza e la quinta tacca lunga. */
  .scala {
    --min: 25;
    --max: 50;
  }
  .cifra-scala {
    font-family: var(--condensato);
    font-size: 8.5px;
    fill: var(--grafite);
    text-anchor: middle;
    dominant-baseline: middle;
  }
  .lancetta {
    stroke: var(--fuorigiri);
    stroke-width: 3.5;
    stroke-linecap: round;
    filter: drop-shadow(0 0 3px rgb(229 57 47 / 0.6));
    transform-box: view-box;
    transform-origin: 100px 100px;
    transform: rotate(calc(135deg + 2.7deg * (var(--min) + var(--max)) / 2));
  }
  .quadrante:has(.totale.in-attesa) .lancetta {
    transform: rotate(135deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lancetta {
      animation: giri 6s ease-in-out infinite;
    }
    /* Accensione, mentre si aspettano i dati: 3 s di oscillazione fra la prima tacca lunga (135°)
       e la seconda (168,75°), poi 3 s ferma sulla prima; e si ricomincia finché i dati non arrivano. */
    .quadrante:has(.totale.in-attesa) .lancetta {
      animation: accensione 6s ease-in-out infinite;
    }
    @keyframes accensione {
      0% { transform: rotate(135deg); }
      7% { transform: rotate(162deg); }
      13% { transform: rotate(142deg); }
      21% { transform: rotate(168deg); }
      29% { transform: rotate(146deg); }
      37% { transform: rotate(165deg); }
      44% { transform: rotate(139deg); }
      50%, 100% { transform: rotate(135deg); }
    }
    @keyframes giri {
      0% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0.05))); }
      10% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0.59))); }
      18% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0.32))); }
      30% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0.94))); }
      38% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0.67))); }
      50% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 1))); }
      62% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0.2))); }
      72% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0.53))); }
      84% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0))); }
      92% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0.26))); }
      100% { transform: rotate(calc(135deg + 2.7deg * (var(--min) + (var(--max) - var(--min)) * 0.05))); }
    }
  }
  .totale {
    position: relative;
    display: grid;
    justify-items: center;
  }
  .totale-nome {
    margin-bottom: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--grafite);
    letter-spacing: 0;
  }
  .totale-riga {
    display: grid;
    grid-template-columns: 1.3em auto 1em;
    align-items: baseline;
    gap: 6px;
    margin: 0;
  }
  .totale-da,
  .totale-euro {
    font-size: 1rem;
    color: var(--grafite);
  }
  .totale-da {
    text-align: right;
  }
  .totale-num {
    font-family: var(--condensato);
    font-size: clamp(2.75rem, 11vw, 3.5rem);
    font-weight: 600;
    line-height: 1.02;
    color: var(--inchiostro);
    text-align: center;
  }
  .totale-unita {
    position: absolute;
    bottom: 8%;
    font-family: var(--condensato);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--segnale);
  }
  /* in attesa dei dati: al posto delle cifre, "Calcolo in corso…" */
  .totale-calcolo {
    display: none;
    margin: 18px 0;
    font-family: var(--condensato);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--inchiostro);
  }
  .totale.in-attesa .totale-riga {
    display: none;
  }
  .totale.in-attesa .totale-calcolo {
    display: block;
  }
  .totale-stato {
    margin: 0;
    font-size: 0.875rem;
    color: var(--grafite);
    text-align: center;
  }
  .totale-composizione {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 12px;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--grafite);
  }

  /* ---- le letture: una riga per voce, nome a sinistra e cifra a destra */
  .voce {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 24px;
    padding: 24px 28px;
  }
  .voce + .voce {
    border-top: 1px solid var(--filo);
  }
  .voce > :not(.voce-testa, .voce-importo) {
    grid-column: 1 / -1;
  }
  .voce-testa {
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .voce-testa h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .voce-importo {
    margin: 0;
    font-family: var(--condensato);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
    text-align: right;
    white-space: nowrap;
  }
  .voce-importo :global(.importo-pieno) {
    display: block;
    margin-top: 6px;
    white-space: normal;
  }
  .voce-importo :global(small) {
    font-family: var(--font);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--grafite);
  }
  .voce-nota {
    margin: 4px 0 0;
    font-size: 0.875rem;
    color: var(--grafite);
    max-width: 62ch;
  }
  .voce-nota :global(a) {
    color: var(--grafite);
  }
  .voce-nota :global(.eccezione) {
    display: block;
    margin-top: 6px;
  }
  .asterisco {
    margin-left: 2px;
  }
  .per-chi {
    margin: 6px 0 0;
    font-size: 0.9375rem;
  }
  .officine {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 10px 0 0;
  }
  .officine dt {
    font-size: 0.875rem;
    color: var(--grafite);
  }
  .officine dd {
    margin: 2px 0 0;
    font-family: var(--condensato);
    font-size: clamp(1.625rem, 3.5vw, 2.125rem);
    font-weight: 600;
    line-height: 1.05;
  }
  .officine dd :global(small) {
    font-family: var(--font);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--grafite);
  }

  /* ---- computer di bordo: i dati dell'auto in una fila, separati da filetti */
  .specifiche {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    margin: 0;
    background: var(--carta-2);
    border: 1px solid var(--filo);
    border-top: 0;
    border-radius: 0 0 6px 6px;
  }
  .specifiche :global(div) {
    padding: 14px 20px;
    border-left: 1px solid var(--filo);
    margin-left: -1px;
  }
  .specifiche :global(dt) {
    margin-bottom: 2px;
    font-family: var(--font);
    font-size: 0.8125rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .specifiche :global(dd) {
    margin: 0;
    font-family: var(--condensato);
    font-size: 1.3125rem;
    font-weight: 500;
  }
  .specifiche :global(.spec-nota) {
    display: block;
    font-family: var(--font);
    font-size: 0.8125rem;
    font-weight: 400;
