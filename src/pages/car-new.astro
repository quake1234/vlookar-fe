<script>
  import "../lib/paginaScheda";

  // Abbaglianti del cursore: accesi finché il tasto del mouse è premuto, su qualunque punto.
  const radice = document.documentElement;
  const spegni = () => radice.classList.remove("abbaglianti");
  addEventListener("pointerdown", (e) => {
    if (e.pointerType === "mouse") radice.classList.add("abbaglianti");
  });
  addEventListener("pointerup", spegni);
  addEventListener("pointercancel", spegni);
  addEventListener("blur", spegni);
</script>
