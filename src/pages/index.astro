---
import Base from "../layouts/Base.astro";
import { anniImmatricolazione, FASCE_KM, nomeFasciaKm } from "../lib/ipotesi";
---

<Base title="Vlookar — quanto costa tenere un'auto" legenda={false} pubblica>
  <div class="wrap home">
    <section class="apertura" aria-labelledby="titolo">
      <h1 id="titolo">Guida la tua scelta.</h1>
      <p class="lead">
        Scegli l'auto: bollo, assicurazione e tagliandi di un anno, sommati, con l'origine di ogni cifra.
      </p>

      <form id="scelta" class="scelta pannello" novalidate>
        <ol class="passi">
          <li class="passo">
            <span class="passo-n" aria-hidden="true">1</span>
            <label for="anno"><span class="etichetta">Anno di immatricolazione</span></label>
            <select id="anno">
              <option value="">Auto nuova / non lo so</option>
              {anniImmatricolazione().map((a) => <option value={a}>{a}</option>)}
            </select>
          </li>
          <li class="passo">
            <span class="passo-n" aria-hidden="true">2</span>
            <label for="km"><span class="etichetta">Chilometri</span></label>
            <select id="km">
              <option value="">Non li so</option>
              {FASCE_KM.map((k) => <option value={k}>{nomeFasciaKm(k)}</option>)}
            </select>
          </li>
          <li class="passo">
            <span class="passo-n" aria-hidden="true">3</span>
            <label for="marca"><span class="etichetta">Marca</span></label>
            <select id="marca" required disabled>
              <option value="">Caricamento…</option>
            </select>
          </li>
          <li class="passo">
            <span class="passo-n" aria-hidden="true">4</span>
            <label for="modello"><span class="etichetta">Modello</span></label>
            <select id="modello" required disabled>
              <option value="">Prima scegli la marca</option>
            </select>
          </li>
          <li id="filtri" class="passo filtri" hidden>
            <span class="passo-n" aria-hidden="true"></span>
            <span class="etichetta filtri-titolo" aria-hidden="true">Filtra le versioni</span>
            <div class="filtri-menu">
              <div class="filtro">
                <label for="carrozzeria"><span class="etichetta">Carrozzeria</span></label>
                <select id="carrozzeria"></select>
              </div>
              <div class="filtro">
                <label for="potenza"><span class="etichetta">Potenza</span></label>
                <select id="potenza"></select>
              </div>
            </div>
          </li>
          <li class="passo">
            <span class="passo-n" aria-hidden="true">5</span>
            <label for="allestimento"><span class="etichetta">Motore e allestimento</span></label>
            <select id="allestimento" required disabled>
              <option value="">Prima scegli il modello</option>
            </select>
          </li>
        </ol>
        <div class="azioni">
          <button id="vai" class="btn" type="submit" disabled>Calcola i costi</button>
          <p id="stato" class="stato small muted" role="status" aria-live="polite"></p>
        </div>
      </form>
    </section>

    <aside class="origini" aria-labelledby="origini-titolo">
      <h2 id="origini-titolo">Ogni cifra dice da dove viene</h2>
      <dl>
        <div class="origine-voce">
          <dt><span class="campione" aria-hidden="true"></span>Calcolato</dt>
          <dd>Il bollo: kW, classe Euro e tariffe della tua regione, le stesse che applica l'ACI.</dd>
        </div>
        <div class="origine-voce">
          <dt><span class="campione campione-ufficiale" aria-hidden="true"></span>Dato ufficiale</dt>
          <dd>Le bocciature alla revisione britannica per quel motore, confrontate con la media delle auto della stessa età.</dd>
        </div>
        <div class="origine-voce">
          <dt><span class="campione campione-stima" aria-hidden="true"></span>Stima AI</dt>
          <dd>Prezzo, assicurazione, tagliando e problemi tipici. Indicativi: verificali prima di decidere.</dd>
        </div>
      </dl>
    </aside>
  </div>
</Base>

<style>
  /* La home sta tutta nello schermo, senza scorrere: le misure verticali
     scalano con l'altezza della finestra (vh), non solo con la larghezza. */
  :global(body main:has(> .home)) {
    padding-bottom: 0;
  }
  .home {
    display: grid;
    gap: clamp(12px, 3vh, 40px);
    padding-top: clamp(12px, 3vh, 40px);
    padding-bottom: clamp(12px, 3vh, 40px);
  }
  h1 {
    font-family: var(--condensato);
    font-size: min(clamp(2.75rem, 10vw, 7rem), 11.5vh);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 0.95;
    max-width: 9.5em;
  }
  .lead {
    font-size: 1rem;
    color: var(--grafite);
    margin: clamp(8px, 1.8vh, 20px) 0 clamp(12px, 3vh, 36px);
    max-width: 32em;
  }
  /* Il modulo nel pannello strumenti, come le voci della scheda. */
  .scelta {
    padding: clamp(6px, 1.2vh, 16px) 16px clamp(14px, 2.4vh, 24px);
  }
  .passi {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Sul telefono l'etichetta sta dentro il riquadro del menu, in alto:
     una riga per passo invece di due. */
  .passo {
    position: relative;
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 0 8px;
    align-items: center;
    padding: clamp(3px, 0.8vh, 14px) 0;
    border-bottom: 1px solid var(--filo);
  }
  .passo-n {
    font-family: var(--condensato);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--grafite);
  }
  .passo label {
    position: absolute;
    top: calc(clamp(3px, 0.8vh, 14px) + 5px);
    left: calc(24px + 8px + 13px);
    margin: 0;
    line-height: 1;
    pointer-events: none;
  }
  .passo label .etichetta {
    font-size: 0.6875rem;
  }
  .passo select {
    padding: 17px 12px 3px;
    min-height: 44px;
  }
  /* Filtri delle versioni: due menu affiancati, con l'etichetta sempre dentro il riquadro
     (anche su schermo largo, dove la colonna delle etichette dice "Filtra le versioni"). */
  .filtri-titolo {
    display: none;
  }
  .filtri-menu {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    min-width: 0;
  }
  .filtri-menu:has(.filtro[hidden]) {
    grid-template-columns: 1fr;
  }
  .filtro {
    position: relative;
    min-width: 0;
  }
  .passo .filtro label {
    top: 5px;
    left: 13px;
  }
  .azioni {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: clamp(10px, 2.2vh, 24px);
  }
  .stato {
    margin: 0;
  }
  #vai {
    flex: none;
    min-width: 180px;
  }
  .origini h2 {
    font-family: var(--condensato);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--filo);
  }
  /* Sotto il modulo, la legenda si riduce ai tre campioni in fila. */
  .origini dl {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 8px 0 0;
  }
  .origine-voce dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 0.875rem;
  }
  .origine-voce dd {
    display: none;
    margin: 6px 0 0 34px;
    color: var(--grafite);
    font-size: 0.9375rem;
  }
  /* stessi campioni della barra del costo annuo */
  .campione {
    width: 24px;
    height: 14px;
    flex: none;
    color: var(--inchiostro);
    background: currentColor;
  }
  .campione-ufficiale {
    color: var(--ufficiale);
    background: transparent;
    box-shadow: inset 0 0 0 2px currentColor;
  }
  .campione-stima {
    color: var(--segnale);
    background: var(--tratteggio);
    box-shadow: inset 0 0 0 1px currentColor;
  }
  /* Schermo basso senza colonna laterale: il sottotitolo lascia spazio al modulo. */
  @media (max-width: 999px) and (max-height: 680px) {
    .lead {
      display: none;
    }
    h1 {
      margin-bottom: 12px;
    }
  }
  /* Schermo bassissimo (telefoni piccoli): resta la fila dei campioni, senza titolo. */
  @media (max-width: 999px) and (max-height: 560px) {
    .origini h2 {
      display: none;
    }
    .passo select {
      min-height: 40px;
      padding-top: 15px;
    }
  }
  @media (min-width: 720px) {
    .lead {
      font-size: 1.125rem;
    }
    .passo {
      grid-template-columns: 40px 200px 1fr;
      gap: 12px;
    }
    .passo label {
      position: static;
    }
    .passo label .etichetta {
      font-size: 0.875rem;
    }
    .passo select {
      padding: 0 12px;
      min-height: clamp(38px, 5.5vh, 46px);
    }
    .filtri-titolo {
      display: block;
      font-size: 0.875rem;
    }
    .passo .filtro label {
      position: absolute;
    }
    .passo .filtro select {
      padding: 15px 12px 1px;
    }
    #vai {
      min-width: 220px;
    }
  }
  @media (min-width: 1000px) {
    .home {
      grid-template-columns: 7fr 4fr;
      gap: 80px;
      padding-top: clamp(16px, 6vh, 72px);
      align-items: start;
    }
    .origini {
      margin-top: 12px;
    }
    .origini h2 {
      font-size: 1.625rem;
      padding-bottom: 14px;
    }
    .origini dl {
      display: block;
      margin: 0;
    }
    .origine-voce {
      padding: clamp(8px, 2vh, 16px) 0;
      border-bottom: 1px solid var(--filo);
    }
    .origine-voce dt {
      gap: 10px;
      font-size: 1rem;
    }
    .origine-voce dd {
      display: block;
    }
  }
</style>

<script>
  import { collega } from "../lib/sceltaAuto";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const vai = $<HTMLButtonElement>("vai");
  const allestimento = $<HTMLSelectElement>("allestimento");
  const anno = $<HTMLSelectElement>("anno");
  const km = $<HTMLSelectElement>("km");

  collega({
    anno,
    marca: $("marca"),
    modello: $("modello"),
    allestimento,
    stato: $("stato"),
    filtri: { riga: $("filtri"), carrozzeria: $("carrozzeria"), potenza: $("potenza") },
    suScelta: (id) => (vai.disabled = id === null),
  });

  $<HTMLFormElement>("scelta").addEventListener("submit", (e) => {
    e.preventDefault();
    if (!allestimento.value) return;
    const q = new URLSearchParams({ id: allestimento.value });
    if (anno.value) q.set("year", anno.value);
    if (km.value) q.set("km", km.value);
    location.href = `/car?${q}`;
  });
</script>
