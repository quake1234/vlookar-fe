---
// Logo Vlookar: city car che sale sulla rampa, le due "o" sono le ruote e la "k" è la rampa.
// Sorgente in vroomy-backend/docs/logo/vlookar-rampa.svg. Qui è in linea, non <img>, perché i
// colori seguano le variabili del tema e il pulsante chiaro/scuro, non solo il sistema.
---

<svg class="logo-svg" viewBox="-14 -4 270 108" role="img" aria-hidden="true" focusable="false">
  <defs>
    <g id="vlk-ruota">
      <circle r="17.4" fill="none" stroke="currentColor" stroke-width="6.2" />
      <circle r="12.6" fill="none" stroke="currentColor" stroke-width="1.8" />
      <circle r="10.6" fill="none" stroke="currentColor" stroke-width="1.6" />
      <g stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
        {[0, 36, 72, 108, 144, 180, 216, 252, 288, 324].map((a) => <line y1="-3.6" y2="-10.6" transform={`rotate(${a})`} />)}
      </g>
      <circle r="3.2" style="fill: var(--segnale)" />
    </g>
  </defs>
  <g transform="translate(-10,0)">
    <polygon fill="currentColor" points="0,40 9.6,40 16,67 22.4,40 32,40 21,80 11,80" />
    <path fill="none" stroke="currentColor" stroke-width="9" d="M42.5,18 V69 Q42.5,75.5 49,75.5 H52" />
  </g>
  <g transform="rotate(-12 74 80.5)">
    <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round">
      <path stroke-width="3.6" d="M51,48 V30 C51,20 53,13 60,10.5 Q66,8.5 82,8.5 H98 Q106,8.5 111,13 L124,27.5 Q127,30 131,30.8 L136,31.8 Q141,33 141,38 V48 H138.8 A24,24 0 0 0 97.2,48 H94.8 A24,24 0 0 0 53.2,48 Z" />
      <path stroke-width="2.4" d="M57,26 V20 Q57,14 64,13.2 H80 V26 Z" />
      <path stroke-width="2.4" d="M84,13.2 H98 Q104,13.2 107.5,17 L115.5,26 H84 Z" />
      <path stroke-width="2.4" d="M86,31 H91" />
      <path stroke-width="2.4" d="M135.5,36 H139.5" />
    </g>
    <use href="#vlk-ruota" transform="translate(74,60)" />
    <use href="#vlk-ruota" transform="translate(118,60) rotate(18)" />
  </g>
  <g transform="translate(-25,0) rotate(35 144 80)" fill="currentColor">
    <rect x="144" y="18" width="9" height="62" />
    <polygon points="153,58.5 167,40 178.5,40 153,71" />
    <polygon points="161.5,59 179,80 167.5,80 155.5,65.5" />
  </g>
  <g transform="translate(-6,0)">
    <circle cx="201" cy="60" r="15.5" fill="none" stroke="currentColor" stroke-width="9" />
    <rect x="212" y="40" width="9" height="40" fill="currentColor" />
    <path fill="none" stroke="currentColor" stroke-width="9" d="M232.5,80 V57 A14,14 0 0 1 246.5,43 H253" />
  </g>
</svg>

<style>
  .logo-svg {
    display: block;
    height: 44px;
    width: auto;
    color: var(--inchiostro);
  }
</style>
